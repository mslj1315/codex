POSTGRES_DB=import_local
POSTGRES_USER=import_user
POSTGRES_PASSWORD=local-development-placeholder
POSTGRES_PORT=5432

MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-development-placeholder
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgresql://import_user:local-development-placeholder@postgres:5432/import_local
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=localminio
MINIO_SECRET_KEY=local-development-placeholder
MINIO_BUCKET=restaurant-imports
API_PORT=3000

# Required when LOCAL_CONTAINER_DEVELOPMENT_MODE and DEVELOPMENT_MODE are false.
# Generate a unique high-entropy value outside source control.
AUTH_TOKEN_SECRET=replace-with-a-high-entropy-production-secret

# Keep false in production so the provider refresh cookie is Secure.
# Production provider-console sessions require HTTPS; true is for explicit local HTTP development only.
PROVIDER_BROWSER_DEVELOPMENT_MODE=false

# Used only by the controlled internal operator account provisioning command.
OPERATOR_ACCOUNT_ID=operator_admin
OPERATOR_PASSWORD=replace-with-a-unique-12-character-minimum-password
BCRYPT_WORK_FACTOR=12
OPERATOR_SESSION_TTL_SECONDS=28800
# OPERATOR_COOKIE_SECURE=false

# Serve each browser application from its own URL prefix. The provider console
# never includes internal operator content; the operator console never includes
# provider feedback/customer data.
# PROVIDER_CONSOLE_DIST_DIR=/absolute/path/to/apps/provider-console/dist
# OPERATOR_CONSOLE_DIST_DIR=/absolute/path/to/apps/operator-console/dist
# OPERATOR_API_PROXY_TARGET=http://127.0.0.1:3000

# Optional server-only structured content model. Leave all three unset to disable
# model calls entirely. Never put these values in Android or either console bundle.
# MODEL_PROVIDER=deepseek
# MODEL_MODEL=deepseek-chat
# MODEL_API_KEY=replace-with-server-side-secret
# Optional only when using encrypted model records managed through /admin.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MODEL_CONFIG_ENCRYPTION_KEY=replace-with-base64-32-byte-server-only-key
# MODEL_BASE_URL=https://api.deepseek.com/chat/completions
# MODEL_TIMEOUT_MS=15000
# MODEL_MAX_RETRIES=1

# OpenAI Responses-compatible gateway alternative. MODEL_BASE_URL is the HTTPS
# gateway root, not the /responses endpoint. The API key is server-only.
# MODEL_PROVIDER=openai_responses
# MODEL_MODEL=gpt-5.6-terra-openai-compact
# MODEL_API_KEY=replace-with-server-side-secret
# MODEL_BASE_URL=https://gateway.example/v1

# Storyboard uploads remain disabled until an internal immutable signer exists.
# VIDEO_STORAGE_MODE=disabled
# VIDEO_STORAGE_MODE=internal_signer
# VIDEO_STORAGE_SIGNER_URL=https://internal-storage-signer.example/v1/video-assets
# VIDEO_STORAGE_SIGNER_TOKEN=server-side-only-signer-token
