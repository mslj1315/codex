POSTGRES_DB=import_local
POSTGRES_USER=import_user
POSTGRES_PASSWORD=local-development-placeholder
POSTGRES_PORT=5432

MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-development-placeholder
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgresql://import_user:local-development-placeholder@postgres:5432/import_local
MINIO_ENDPOINT=http://minio:9000
API_PORT=3000

# Used only by the controlled operator account provisioning command.
OPERATOR_ACCOUNT_ID=operator_admin
OPERATOR_PASSWORD=replace-with-a-unique-12-character-minimum-password
BCRYPT_WORK_FACTOR=12
OPERATOR_SESSION_TTL_SECONDS=28800
# Defaults to true when NODE_ENV=production; set false only for local HTTP development.
# OPERATOR_COOKIE_SECURE=false
# Operator CSRF compares Origin against the direct request scheme and Host. Because
# trustProxy is disabled, terminate TLS at the API or preserve HTTPS end-to-end;
# do not enable client-controlled forwarded protocol headers for this check.

# To serve the built operator console from this API's HTTPS origin, set this to
# the absolute deployed apps/provider-console/dist directory after running its build.
# Local Vite development proxies /v1 to OPERATOR_API_PROXY_TARGET and rewrites
# only the proxy Origin to the API origin so strict server-side origin checks hold.
# OPERATOR_CONSOLE_DIST_DIR=/absolute/path/to/apps/provider-console/dist
# OPERATOR_API_PROXY_TARGET=http://127.0.0.1:3000
