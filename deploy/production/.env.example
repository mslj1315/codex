# Copy this file to deploy/production/.env only on the production server.
# The real .env must be owned by root and protected with chmod 600. Do not commit it.

POSTGRES_DB=restaurant_ops
POSTGRES_USER=restaurant_ops
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DATABASE_PASSWORD
# Use the same generated password after percent-encoding it for a URI. The
# production procedure generates a hexadecimal password, which is URI-safe.
DATABASE_URL=postgresql://restaurant_ops:REPLACE_WITH_PERCENT_SAFE_DATABASE_PASSWORD@postgres:5432/restaurant_ops

# Generate a distinct, high-entropy value on the server. This is API-only.
AUTH_TOKEN_SECRET=REPLACE_WITH_GENERATED_SECRET

# Responses-compatible model provider settings. All values remain server-only;
# never add the gateway key to Android, browser bundles, Nginx, or source control.
MODEL_PROVIDER=openai_responses
MODEL_MODEL=REPLACE_WITH_APPROVED_MODEL_ID
MODEL_API_KEY=REPLACE_WITH_SERVER_ONLY_GATEWAY_KEY
MODEL_BASE_URL=https://gateway.example/v1
MODEL_TIMEOUT_MS=15000
MODEL_MAX_RETRIES=1

# Video upload, object storage, FFmpeg rendering, and auto-publishing are disabled.
VIDEO_STORAGE_MODE=disabled
